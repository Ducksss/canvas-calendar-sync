<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chaipinzheng.canvas-calendar-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/chaipinzheng/Library/Application Support/CanvasCalendarSync/.venv/bin/canvas-calendar-sync</string>
    <string>sync</string>
    <string>--scheduled</string>
    <string>--json</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/chaipinzheng/Library/Application Support/CanvasCalendarSync</string>

  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>TZ</key>
    <string>Asia/Singapore</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/chaipinzheng/Library/Logs/CanvasCalendarSync/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chaipinzheng/Library/Logs/CanvasCalendarSync/launchd.stderr.log</string>
</dict>
</plist>
